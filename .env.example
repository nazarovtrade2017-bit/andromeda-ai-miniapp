# --- Telegram ---
BOT_TOKEN=123456:replace_me

# --- Server ---
PORT=3000
PUBLIC_URL=http://localhost:3000
DB_PATH=./data/app.db
NODE_ENV=development
# Local testing without Telegram (ignored when NODE_ENV=production)
DEV_BYPASS_AUTH=1

# --- Product rules ---
FREE_LIMIT=3
DAY_TZ=Europe/Kyiv

# --- Postback / admin secrets (generate long random strings) ---
POSTBACK_SECRET=change_me_long_random
ADMIN_KEY=change_me_too

# --- Partner link ---
# Until the real tracking link is available, leave empty: the built-in simulator is used.
# Real format example: https://pocket1.click/smart/XXXX?model=sr&click_id={click_id}&site_id=miniapp-demo
PARTNER_LINK_TEMPLATE=
ENABLE_SIM=1

# --- Test users shown with a label in the admin table (telegram_id:label,...) ---
TEST_USERS=
